# ── ManageBac Timetable Sync — local config template ──────────────────────
# Copy this file to `.env` for LOCAL runs only. `.env` is git-ignored.
# For GitHub Actions, set these as repository SECRETS instead (never commit).

# ── ManageBac account ─────────────────────────────────────────────────────
MANAGEBAC_BASE_URL=https://ycishk.managebac.com
MANAGEBAC_USERNAME=your_login_here
MANAGEBAC_PASSWORD=your_password_here

# Timetable URL (verify after login; the nav "Timetables" tab). Only used in
# browser mode. The /student/timetable path is a best guess.
MANAGEBAC_TIMETABLE_PATH=/student/timetable

# How many weeks ahead to scrape (default 4)
MANAGEBAC_WEEKS_AHEAD=4

# ── Timezone & naming ─────────────────────────────────────────────────────
MANAGEBAC_TZ=Asia/Shanghai
ICS_CALNAME=ManageBac Timetable
ICS_FILENAME=managebac_timetable.ics

# ── Source mode ───────────────────────────────────────────────────────────
# OPTION A (simplest): paste ManageBac's official "Subscribe to Calendar" iCal
# URL here (it contains an auth token; gives events/deadlines/tasks, NOT the
# weekly class timetable). If set, it overrides browser mode.
# MANAGEBAC_ICAL_URL=https://ycishk.managebac.com/.../calendar.ics

# ── Privacy / publish path ────────────────────────────────────────────────
# A random secret used as the unguessable subdirectory. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PUBLISH_TOKEN=

# ── Failure notifications (pick ONE; all optional) ────────────────────────
# Server酱 (push to 微信服务号): https://sct.ftqq.com
# NOTIFY_SERVERCHAN_SENDKEY=
# PushPlus (push to 微信): https://www.pushplus.plus
# NOTIFY_PUSHPLUS_TOKEN=
# 企业微信群机器人 webhook URL
# NOTIFY_WECHAT_WEBHOOK=
# Generic webhook (POST JSON {"title","content"})
# NOTIFY_WEBHOOK_URL=

# ── 轮换周期（Week A/B）与课程过滤 ───────────────────────────────────────
# Week A/B 轮换：两周一轮。本周(9/7–9/11)是 Week B，故 9/14 那一周是 Week A。
CYCLE_LENGTH=2
CYCLE_NAMES=A,B
CYCLE_ANCHOR_DATE=2026-09-14

# 排除不要的课（逗号分隔，子串匹配，不区分大小写）。
# 同名同时段有两个中文课，只留 ... (Year 11) 10，排除 ... (Year 11) 7：
CLASS_EXCLUDE=CAIE IGCSE Chinese - First Language (Year 11) 7
# 白名单（一般不用；若设置，只保留匹配的课）
CLASS_INCLUDE=

# ── Debug ─────────────────────────────────────────────────────────────────
# DEBUG=1 dumps HTML/JSON/screenshot into ./debug/ for parser tuning.
DEBUG=0
